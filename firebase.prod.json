{
  // Production Firebase Hosting configuration.
  // Uses "dist/" directory (Vite build output) with Cloud Run rewrites for API endpoints.
  // DO NOT use firebase.json for production deploys - it points to "public/" (empty).
  // See DEPLOYMENT.md for configuration differences.
  "hosting": {
    "public": "dist",
    "versions": { "maxVersions": 5 },
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/assets/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      },
      {
        "source": "**",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "run": { "serviceId": "crew-predictions", "region": "us-east5" }
      },
      {
        "source": "/auth/**",
        "run": { "serviceId": "crew-predictions", "region": "us-east5" }
      },
      {
        "source": "/admin/**",
        "run": { "serviceId": "crew-predictions", "region": "us-east5" }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
